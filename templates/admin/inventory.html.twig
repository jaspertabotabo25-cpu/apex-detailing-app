{% extends 'admin/base.html.twig' %}

{% block title %}Inventory & Supplies - Apex Admin{% endblock %}
{% block page_title %}Supplies & Inventory Management{% endblock %}
{% block page_subtitle %}Track detailing chemicals, ceramic coatings, towels, and low stock warnings{% endblock %}

{% block body %}
<div style="display:grid; grid-template-columns:2fr 1fr; gap:24px;">
    <!-- Inventory Table -->
    <div class="card">
        <h2 style="font-size:1.15rem; font-family:'Poppins', sans-serif; margin-bottom:15px;">Current Stock</h2>

        {% if inventory|length > 0 %}
            <table class="table">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Quantity</th>
                        <th>Low Stock Threshold</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in inventory %}
                        <tr>
                            <td>
                                <strong>{{ item.itemName }}</strong>
                                <div style="font-size:0.75rem; color:#64748b;">Updated: {{ item.lastUpdated|date('M j, Y') }}</div>
                            </td>
                            <td>
                                <form action="{{ path('admin_inventory_update', { id: item.id }) }}" method="POST" style="display:flex; align-items:center; gap:6px;">
                                    <input type="number" name="quantity" value="{{ item.quantity }}" min="0" style="width:65px; padding:4px 6px; border:1px solid #cbd5e1; border-radius:4px; font-size:0.85rem;">
                            </td>
                            <td>
                                    <input type="number" name="threshold" value="{{ item.lowStockThreshold }}" min="0" style="width:65px; padding:4px 6px; border:1px solid #cbd5e1; border-radius:4px; font-size:0.85rem;">
                            </td>
                            <td>
                                {% if item.isLowStock %}
                                    <span style="background:#fee2e2; color:#b91c1c; padding:3px 8px; border-radius:12px; font-weight:700; font-size:0.75rem;">
                                        LOW STOCK
                                    </span>
                                {% else %}
                                    <span style="background:#dcfce7; color:#166534; padding:3px 8px; border-radius:12px; font-weight:600; font-size:0.75rem;">
                                        SUFFICIENT
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="display:flex; gap:6px;">
                                    <button type="submit" class="btn btn-navy" style="padding:4px 8px; font-size:0.75rem;">Update</button>
                                </form>
                                <form action="{{ path('admin_inventory_delete', { id: item.id }) }}" method="POST" onsubmit="return confirm('Remove {{ item.itemName }} from inventory?');">
                                    <button type="submit" class="btn btn-outline" style="padding:4px 8px; font-size:0.75rem; color:#dc2626; border-color:#fca5a5;">Delete</button>
                                </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p style="color:#64748b; padding:20px 0; text-align:center;">No inventory supplies recorded yet.</p>
        {% endif %}
    </div>

    <!-- Add Item Form -->
    <div>
        <div class="card">
            <h2 style="font-size:1.15rem; font-family:'Poppins', sans-serif; margin-bottom:15px;">Add Supply Item</h2>
            <form action="{{ path('admin_inventory_add') }}" method="POST">
                <div style="margin-bottom:14px;">
                    <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:4px;">Item Name</label>
                    <input type="text" name="item_name" required placeholder="e.g. Foam Cannon Soap 5L" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:6px; font-size:0.9rem;">
                </div>

                <div style="margin-bottom:14px;">
                    <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:4px;">Initial Quantity</label>
                    <input type="number" name="quantity" value="10" min="0" required style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:6px; font-size:0.9rem;">
                </div>

                <div style="margin-bottom:20px;">
                    <label style="display:block; font-size:0.85rem; font-weight:600; margin-bottom:4px;">Low Stock Alert Threshold</label>
                    <input type="number" name="threshold" value="3" min="0" required style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:6px; font-size:0.9rem;">
                </div>

                <button type="submit" class="btn btn-navy" style="width:100%; padding:10px; font-size:0.9rem;">+ Add To Inventory</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

